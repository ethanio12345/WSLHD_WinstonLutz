# machines.yaml — copy to machines.yaml and edit for your centre.
# Only machines.yaml.example is committed; machines.yaml is gitignored.
#
# All paths are CONTAINER paths (what the app sees inside Docker).
# See docker-compose.yml for the host→container volume mapping.

machines:
  LA2:
    display_name: "LA2 (TrueBeam)"
    dicom_roots:
      winston_lutz: /data/LA2/WinstonLutz
      # CatPhan is independently optional per machine. Uncomment to enable:
      # catphan: /data/LA2/CatPhan
      # Note: `field_profile` is NOT a per-machine dicom_root key (the Field
      # Profile page is decoupled from machines — see top-level `field_profile`
      # config below). A legacy `field_profile` entry here is silently ignored.
    output_root: /data/LA2/output      # per-machine output (WL/CatPhan written as subfolders)

# Field Profile page config (decoupled from machines). The page is always
# available; this optional section configures the cascading folder browser root.
field_profile:
  browse_root: /data                   # root of the cascading folder browser (default: /data)

  LA3:
    display_name: "LA3"
    dicom_roots:
      winston_lutz: /data/LA3/WinstonLutz
    output_root: /data/LA3/output

  LA4:
    display_name: "LA4"
    dicom_roots:
      winston_lutz: /data/LA4/WinstonLutz
    output_root: /data/LA4/output

  LA5:
    display_name: "LA5"
    dicom_roots:
      winston_lutz: /data/LA5/WinstonLutz
    output_root: /data/LA5/output

  OBK:
    display_name: "OBK (TrueBeam)"
    dicom_roots:
      winston_lutz: /data/OBK/WinstonLutz
    output_root: /data/OBK/output

  CST:
    display_name: "CST"
    dicom_roots:
      winston_lutz: /data/CST/WinstonLutz
    output_root: /data/CST/output

  # Rainforest:
  #   display_name: "Rainforest"
  #   dicom_roots:
  #     winston_lutz: /data/RAINFOREST/WinstonLutz
  #   output_root: /data/RAINFOREST/output

analysis_defaults:
  winston_lutz:
    # Required keys:
    bb_size_mm: 5.0
    machine_scale: VARIAN_IEC      # one of: VARIAN_IEC, VARIAN_STANDARD, IEC61217
    tolerance_mm: 1.0              # UI-only pass/fail threshold (not passed to pylinac)
    # Optional keys (fall back to pylinac defaults if absent):
    # low_density_bb: false
    # open_field: false
    # apply_virtual_shift: false
    # snap_tolerance: 5
    # gantry_reference: 0
    # collimator_reference: 0
    # couch_reference: 0
  # CatPhan defaults — required iff any machine has `catphan` configured.
  # Uncomment together with the catphan dicom_root above to enable the CatPhan page.
  # catphan:
  #   # Required keys:
  #   hu_tolerance: 40
  #   scaling_tolerance: 0.5          # mm
  #   slice_thickness_tolerance: 0.5  # mm
  #   # Optional keys (fall back to pylinac defaults if absent):
  #   # thickness_slice_straddle: auto   # auto | 0 | 1 | 2 | 3
  #   # expected_hu_values:             # dict; config-only (not in the Advanced sidebar)
  #   #   Air: -999
  #   #   PMP: -203
  #   # x_adjustment: 0
  #   # y_adjustment: 0
  #   # angle_adjustment: 0
  #   # roi_size_factor: 1.0
  #   # scaling_factor: 1.0
  #   # minimum_rois_seen: 3
  # Field Profile defaults — OPTIONAL centre-wide config (the page is always
  # available; if this section is absent, the page uses protocol: VARIAN +
  # pylinac defaults). Uncomment to customise.
  # field_profile:
  #   # Required key:
  #   protocol: VARIAN              # one of: VARIAN, SIEMENS, ELEKTA
  #   # Optional keys (fall back to pylinac defaults if absent):
  #   # centering: BEAM_CENTER
  #   # in_field_ratio: 0.8
  #   # penumbra: [20, 80]
  #   # is_fff: false                # default; auto-detected per image
  #   # interpolation: LINEAR
  #   # edge_detection_method: INFLECTION_DERIVATIVE
  #   # vert_position: 0.5
  #   # horiz_position: 0.5
  #   # vert_width: 0
  #   # horiz_width: 0
  #   # slope_exclusion_ratio: 0.2
  #   # edge_smoothing_ratio: 0.003
  #   # hill_window_ratio: 0.15

assets:
  fry_meme_path: /assets/fry_money.png
  logo_path: /assets/logo.png
